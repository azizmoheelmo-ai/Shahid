{
  "rewrites": [
    {
      "source": "/r/:code",
      "destination": "/api/r?c=:code"
    },
    {
      "source": "/s/:code",
      "destination": "/api/s?c=:code"
    }
  ],
  "headers": [
    {
      "source": "/((?!s/).*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
